// nvcurve-gui — Polkit Rule (optional, opt-in via install.sh)
// ════════════════════════════════════════════════════════════════════════
//
// Installed under /etc/polkit-1/rules.d/. Real JavaScript rule format
// (polkit.addRule) — this grants FULLY passwordless authorization of the
// com.nvcurve.gui.set-params action (root_helper.py) for local, active
// sessions belonging to an admin group (wheel/sudo).
//
// This is safe because root_helper.py is:
//   - owned by root:root, mode 0700 (unreadable/unwritable by the user),
//   - restricted to a fixed allowlist (the OPERATIONS dict),
//   - validating names/paths/sizes on every op that touches the filesystem.
// So this rule grants passwordless access to one narrow, audited helper —
// not blanket root access.
//
// Adjust the group name for your distro: Gentoo/Arch typically use
// "wheel", Debian/Ubuntu typically use "sudo" — both are checked below.
//
// To disable passwordless auth (prompt every few minutes instead), delete
// this file; the fallback is <allow_active>auth_admin_keep</allow_active>
// in com.nvcurve.gui.policy.

polkit.addRule(function(action, subject) {
    if (action.id == "com.nvcurve.gui.set-params" &&
        subject.active && subject.local &&
        (subject.isInGroup("wheel") || subject.isInGroup("sudo"))) {
        return polkit.Result.YES;
    }
});
