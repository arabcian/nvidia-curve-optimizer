/*
 * 49-nvcurve-gui.rules
 *
 * Grants the nvcurve-gui actions without a password prompt to a member of `wheel` or `sudo` sitting at
 * the machine (local + active session). `wheel` is the admin group on Gentoo and many others; Debian and
 * Ubuntu use `sudo`. A missing group simply does not match. Everyone else -- SSH, another seat, a
 * fast-user-switched session, service accounts -- gets auth_admin.
 *
 * Why a .rules file rather than only <allow_active> in the .policy:
 *
 *   - The .policy defaults are only consulted when no rule matches, and some distributions ship rules of
 *     their own (50-default.rules, vendor packages) that match first and force auth_admin_keep for anything
 *     run through org.freedesktop.policykit.exec. A 49-* file sorts ahead of them.
 *
 *   - It also covers the generic org.freedesktop.policykit.exec fallback pkexec uses when it cannot match
 *     a helper to a pinned action -- matched here only for the exact helper paths below.
 *
 * Scope: only the two fixed programs under @LIBEXEC@/, which install.sh creates root:root (0700 for
 * nvcurve-root-helper). A non-root user cannot add or alter a file there. The helper re-validates every
 * request itself (strict op allowlist, profile-name pattern, realpath containment, schema and range
 * checks, limits re-read live from the driver), so the prompt is not what keeps a bad value out.
 *
 * The .policy defaults are auth_admin_keep: if this file is missing or not loaded, nobody gets a silent
 * grant -- except the read-only sensors action, whose allow_active is yes.
 *
 * Security level (chosen at install time, install.sh --security-level=N):
 *   1  the behaviour described above: wheel or sudo, local and active, is silent.
 *   2  no silent grants: the same session gets auth_admin_keep (one password, then polkit's own cache
 *      window) for the curve helper. Only the read-only sensor stream stays silent.
 * Rerun install.sh to change it.
 *
 * Action ids are matched against an explicit allowlist (ACTION_IDS), not by the com.nvcurve.gui. prefix;
 * unlisted ids in that namespace get AUTH_ADMIN. When adding an action to com.nvcurve.gui.policy, add its
 * id here too (install.sh checks this).
 */

// Only a local, active session of an admin (wheel or sudo) is granted silently;
// everyone else (SSH, other seats, service accounts) gets auth_admin.
function adminAtConsole(subject) {
    return subject.local && subject.active &&
        (subject.isInGroup("wheel") || subject.isInGroup("sudo"));
}
var HELPERS = ["nvcurve-root-helper", "nvcurve-sensors"].map(function (h) {
    return "@LIBEXEC@/" + h;
});
var SECURITY_LEVEL = @SECLEVEL@;
var ACTION_IDS = ["com.nvcurve.gui.set-params", "com.nvcurve.gui.sensors"];
// Read-only helper that stays silent at every level.
var SILENT_IDS = ["com.nvcurve.gui.sensors"];
var SILENT_HELPERS = ["@LIBEXEC@/nvcurve-sensors"];

polkit.addRule(function (action, subject) {
    // Any other com.nvcurve.gui.* id is unknown to this file: password, never cached, never silent.
    if (action.id.indexOf("com.nvcurve.gui.") === 0 && ACTION_IDS.indexOf(action.id) < 0) {
        return polkit.Result.AUTH_ADMIN;
    }
    var ours = ACTION_IDS.indexOf(action.id) >= 0 ||
        (action.id === "org.freedesktop.policykit.exec" &&
         HELPERS.indexOf(action.lookup("program")) >= 0);
    if (!ours) { return; }
    if (adminAtConsole(subject)) {
        var silent = SILENT_IDS.indexOf(action.id) >= 0 ||
            (action.id === "org.freedesktop.policykit.exec" && SILENT_HELPERS.indexOf(action.lookup("program")) >= 0);
        return (SECURITY_LEVEL >= 2 && !silent) ? polkit.Result.AUTH_ADMIN_KEEP : polkit.Result.YES;
    }
    return polkit.Result.AUTH_ADMIN;
});
